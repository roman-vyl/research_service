{
  "schema_version": 1,
  "experiment_id": "smoke_managed_parsing_v2",
  "family": "ema_pullback",
  "execution": {
    "init_cash": 10000.0,
    "fees": 0.0006,
    "slippage": 0.0001
  },
  "instances": [
    {
      "instance_id": "managed_component_pack",
      "variant": "ema_pullback_fast100_anchor200_slow1000",
      "market": {
        "symbol": "BTCUSDT",
        "base_timeframe": "1h"
      },
      "strategy": {
        "trade_sides": ["long"],
        "anchor_stack": {
          "source": "close",
          "timeframe": "base",
          "fast": 100,
          "anchor": 200,
          "slow": 1000
        },
        "direction": { "component_id": "ema_anchor_stack_trend" },
        "setups": [
          {
            "instance_id": "setup",
            "component_id": "untouched_anchor_setup",
            "lookback": 50,
            "active_bars": 3
          }
        ],
        "trigger": { "component_id": "reclaim_anchor", "lookback": 1 },
        "blockers": [{ "instance_id": "no_blockers", "component_id": "no_blockers" }],
        "risk": { "component_id": "no_risk_filter" },
        "trade_management": {
          "exit_policy": {
            "always_on": {
              "exits": [
                {
                  "instance_id": "atr_sl",
                  "component_id": "atr_stop_loss",
                  "distance": { "timeframe": "base", "period": 14, "multiplier": 2.0 }
                },
                {
                  "instance_id": "atr_tp",
                  "component_id": "atr_take_profit",
                  "distance": { "timeframe": "base", "period": 14, "multiplier": 4.0 }
                }
              ]
            },
            "profiles": {
              "aligned": { "exits": [] },
              "countertrend": { "exits": [] },
              "neutral": { "exits": [] }
            }
          },
          "exit_management": {
            "mode": "managed",
            "phase_rules": [
              {
                "rule_id": "to_proven_at_1atr",
                "to_phase": "proven",
                "condition": {
                  "component_id": "mfe_atr",
                  "params": {
                    "threshold": 1.0,
                    "atr": { "timeframe": "base", "period": 14 }
                  }
                }
              },
              {
                "rule_id": "to_protected_at_1_5atr",
                "to_phase": "protected",
                "condition": {
                  "component_id": "mfe_atr",
                  "params": {
                    "threshold": 1.5,
                    "atr": { "timeframe": "base", "period": 14 }
                  }
                }
              },
              {
                "rule_id": "to_exhaustion_after_48_bars",
                "to_phase": "exhaustion",
                "condition": {
                  "component_id": "bars_in_trade",
                  "params": { "threshold": 48 }
                }
              }
            ],
            "stop_management": [
              {
                "rule_id": "be_after_protected",
                "component_id": "break_even_stop",
                "activate_when": { "phase_at_least": "protected" },
                "params": {
                  "buffer_type": "atr",
                  "buffer_atr": 0.2,
                  "atr_period": 14
                }
              },
              {
                "rule_id": "lock_profit_after_protected",
                "component_id": "lock_profit_stop",
                "activate_when": { "phase_at_least": "protected" },
                "params": {
                  "lock_atr": 0.5,
                  "atr_period": 14,
                  "atr": { "timeframe": "base", "period": 14 }
                }
              }
            ],
            "take_management": [
              {
                "rule_id": "disable_initial_tp_runner",
                "component_id": "take_profile_switch",
                "activate_when": { "phase_at_least": "runner" },
                "params": {
                  "action": "disable_initial_tp"
                }
              }
            ],
            "runtime_exits": [
              {
                "rule_id": "exit_on_exhaustion",
                "component_id": "phase_runtime_exit",
                "activate_when": { "phase_at_least": "exhaustion" },
                "params": { "exit_price": "close" }
              }
            ]
          }
        }
      }
    }
  ]
}
